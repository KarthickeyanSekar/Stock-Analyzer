# =============================================================================
# Stock Analyzer: environment template
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Only bootstrap values live here; provider API keys are entered in the admin
# UI and stored encrypted in the database (docs/22-provider-configuration-ui.md).
# Full variable reference: docs/25-infrastructure-services-inventory.md
# =============================================================================

# --- Environment -------------------------------------------------------------
# dev | test | prod. Controls debug behaviour, logging defaults and safety checks.
SA_ENV=dev

# --- Database (PostgreSQL 16 + TimescaleDB + pgvector) -------------------------
# Login used by the app; the compose `db` container is created with these values.
SA_DB_USER=stock_analyzer
# Change for every environment; never reuse the prod password.
SA_DB_PASSWORD=change-me
# Database name (dev uses e.g. dev_stock_analyzer).
SA_DB_NAME=stock_analyzer
# Full async connection URL. Host `db` = the database container on the Docker
# network (the standalone dev container is attached as `db` by `make dev-network`).
SA_DATABASE_URL=postgresql+asyncpg://stock_analyzer:change-me@db:5432/stock_analyzer

# --- Redis (cache for latest snapshots, job queue) -----------------------------
# Host `redis` = the Redis container on the Docker network.
SA_REDIS_URL=redis://redis:6379/0

# --- Security ------------------------------------------------------------------
# Encrypts provider credentials stored in the database. Keep a copy in a password
# manager: losing it means re-entering every provider key. Use a different key per
# environment.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SA_MASTER_KEY=

# --- Logging -------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
SA_LOG_LEVEL=INFO

# --- OpenTelemetry: traces, metrics and logs -> Grafana at http://localhost:3000 -
# true | false
SA_OTEL_ENABLED=true
# otlp = send to Grafana (make dev) · file = JSON Lines in ./telemetry/ (no Grafana needed)
SA_OTEL_EXPORTER=otlp
# Service name shown in Grafana traces and logs.
SA_OTEL_SERVICE_NAME=stock-analyzer-api
