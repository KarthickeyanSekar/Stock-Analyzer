# Copy to .env and fill in. Only bootstrap values live here;
# provider credentials are entered in the admin UI and stored encrypted.
SA_ENV=dev
SA_DB_USER=stock_analyzer
SA_DB_PASSWORD=change-me
SA_DB_NAME=stock_analyzer
SA_DATABASE_URL=postgresql+asyncpg://stock_analyzer:change-me@db:5432/stock_analyzer
SA_REDIS_URL=redis://redis:6379/0
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SA_MASTER_KEY=
SA_LOG_LEVEL=INFO

# OpenTelemetry: traces, metrics and logs -> Grafana at http://localhost:3000
SA_OTEL_ENABLED=true
# otlp = send to Grafana (make dev) · file = JSON Lines in ./telemetry/ (no Grafana needed)
SA_OTEL_EXPORTER=otlp
SA_OTEL_SERVICE_NAME=stock-analyzer-api
